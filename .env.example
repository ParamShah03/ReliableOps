APP_NAME=ReliableOps
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://reliableops:reliableops@db:5432/reliableops
REDIS_URL=redis://redis:6379/0

# Runs fully locally by default. No API key required.
LLM_PROVIDER=mock
LLM_MODEL=gpt-5.6
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=64
MAX_AGENT_STEPS=12
MAX_SAME_TOOL_SIGNATURE=2
AUTO_SEED_KNOWLEDGE=true
CELERY_TASK_ALWAYS_EAGER=false
